{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightpath.nasa.spaceapps/schemas/missions.schema.json",
  "title": "Missions",
  "description": "List of CLPS and lunar surface exploration missions associated with landing sites",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "operator",
      "site_id",
      "planned_window_start",
      "planned_window_end",
      "status",
      "description",
      "source_links",
      "verified"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "name": {
        "type": "string"
      },
      "operator": {
        "type": "string"
      },
      "site_id": {
        "type": ["string", "null"]
      },
      "planned_window_start": {
        "type": "string"
      },
      "planned_window_end": {
        "type": "string"
      },
      "mission_window": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "start_utc": { "type": ["string", "null"] },
          "end_utc": { "type": ["string", "null"] }
        },
        "required": ["description"]
      },
      "analysis_window": {
        "type": "object",
        "properties": {
          "start_utc": { "type": "string" },
          "end_utc": { "type": "string" }
        },
        "required": ["start_utc", "end_utc"]
      },
      "status": {
        "type": "string",
        "enum": ["planned", "en_route", "landed", "completed", "cancelled", "unverified_placeholder", "unverified_example", "unverified"]
      },
      "description": {
        "type": "string"
      },
      "source_links": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "verified": {
        "type": "boolean"
      },
      "is_synthetic": {
        "type": "boolean"
      },
      "is_example": {
        "type": "boolean"
      },
      "source_label": {
        "type": "string"
      },
      "source_url": {
        "type": "string"
      },
      "retrieved_on": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
