{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightpath.nasa.spaceapps/schemas/mission_plan.schema.json",
  "title": "MissionPlanResult",
  "description": "Multi-stop spatio-temporal mission plan with dwell constraints, timeline lanes, and violation analysis",
  "type": "object",
  "required": [
    "mission_name",
    "start_coord",
    "start_time_idx",
    "start_time_utc",
    "feasible",
    "stops",
    "legs",
    "dwells",
    "timeline",
    "metrics",
    "violations",
    "limits_disclaimer"
  ],
  "properties": {
    "mission_name": {
      "type": "string"
    },
    "start_coord": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "start_time_idx": {
      "type": "integer",
      "minimum": 0
    },
    "start_time_utc": {
      "type": "string"
    },
    "feasible": {
      "type": "boolean"
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["stop_id", "name", "coord", "dwell_time_h"],
        "properties": {
          "stop_id": { "type": "string" },
          "name": { "type": "string" },
          "coord": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          },
          "dwell_time_h": { "type": "number", "minimum": 0.0 },
          "min_sun_frac": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "min_earth_frac": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "min_earth_duration_h": { "type": "number", "minimum": 0.0 },
          "deadline_idx": { "type": "integer", "minimum": 0 },
          "deadline_utc": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "leg_index",
          "from_name",
          "to_name",
          "start_coord",
          "end_coord",
          "start_time_idx",
          "end_time_idx",
          "start_time_utc",
          "end_time_utc",
          "feasible",
          "duration_h",
          "distance_m"
        ],
        "properties": {
          "leg_index": { "type": "integer" },
          "from_name": { "type": "string" },
          "to_name": { "type": "string" },
          "start_coord": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "end_coord": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "start_time_idx": { "type": "integer" },
          "end_time_idx": { "type": "integer" },
          "start_time_utc": { "type": "string" },
          "end_time_utc": { "type": "string" },
          "feasible": { "type": "boolean" },
          "duration_h": { "type": "number", "minimum": 0.0 },
          "distance_m": { "type": "number", "minimum": 0.0 },
          "dark_duration_h": { "type": "number", "minimum": 0.0 },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "t"],
              "properties": {
                "x": { "type": "integer" },
                "y": { "type": "integer" },
                "t": { "type": "integer" }
              }
            }
          },
          "infeasible_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "dwells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stop_id",
          "name",
          "coord",
          "start_time_idx",
          "end_time_idx",
          "start_time_utc",
          "end_time_utc",
          "duration_h",
          "sun_satisfied",
          "earth_satisfied",
          "deadline_satisfied",
          "violations"
        ],
        "properties": {
          "stop_id": { "type": "string" },
          "name": { "type": "string" },
          "coord": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "start_time_idx": { "type": "integer" },
          "end_time_idx": { "type": "integer" },
          "start_time_utc": { "type": "string" },
          "end_time_utc": { "type": "string" },
          "duration_h": { "type": "number", "minimum": 0.0 },
          "min_sun_frac_observed": { "type": "number" },
          "earth_contact_duration_h": { "type": "number" },
          "sun_satisfied": { "type": "boolean" },
          "earth_satisfied": { "type": "boolean" },
          "deadline_satisfied": { "type": "boolean" },
          "violations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "type",
          "label",
          "start_time_idx",
          "end_time_idx",
          "start_time_utc",
          "end_time_utc",
          "duration_h",
          "violations"
        ],
        "properties": {
          "event_id": { "type": "string" },
          "type": { "type": "string", "enum": ["transit", "dwell", "wait"] },
          "label": { "type": "string" },
          "start_time_idx": { "type": "integer" },
          "end_time_idx": { "type": "integer" },
          "start_time_utc": { "type": "string" },
          "end_time_utc": { "type": "string" },
          "duration_h": { "type": "number", "minimum": 0.0 },
          "sun_frac_min": { "type": "number" },
          "sun_frac_avg": { "type": "number" },
          "earth_frac_min": { "type": "number" },
          "earth_frac_avg": { "type": "number" },
          "violations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "total_distance_m",
        "transit_duration_h",
        "dwell_duration_h",
        "total_duration_h",
        "total_dark_duration_h",
        "num_stops"
      ],
      "properties": {
        "total_distance_m": { "type": "number", "minimum": 0.0 },
        "transit_duration_h": { "type": "number", "minimum": 0.0 },
        "dwell_duration_h": { "type": "number", "minimum": 0.0 },
        "total_duration_h": { "type": "number", "minimum": 0.0 },
        "total_dark_duration_h": { "type": "number", "minimum": 0.0 },
        "num_stops": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stop_index", "stop_name", "type", "details"],
        "properties": {
          "stop_index": { "type": "integer" },
          "stop_name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["transit_infeasible", "insufficient_sun", "insufficient_earth_link", "deadline_missed"]
          },
          "details": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "fix_recommendation": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string" },
        "description": { "type": "string" },
        "suggested_patch": { "type": "object" }
      },
      "additionalProperties": true
    },
    "limits_disclaimer": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
